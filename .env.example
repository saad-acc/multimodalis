# Multimodalis local / Cloud Run env template — no real secrets.
# Copy to `.env` for local overrides (gitignored). Compose also sets defaults.

# local | sandbox | prod
APP_ENV=local

# stub = offline login without DB (local default + Cloud Run this slice)
# db   = password_verify against existing Cloud SQL user rows (DEFERRED — Better Auth)
AUTH_MODE=stub

# Optional stub gate. If both empty, any non-empty email+password succeeds.
# STUB_EMAIL=you@example.com
# STUB_PASSWORD=change-me

# Cloud SQL sandbox instance (non-secret). Sole DB target this phase.
# Form: PROJECT:REGION:INSTANCE
INSTANCE_CONNECTION_NAME=bestmodal-492819:europe-west1:bestmodal2-sandbox-mysql

# socket = Cloud Run Unix socket under /cloudsql/... (DEFERRED attach this slice)
# tcp    = local Auth Proxy (primary) or Compose MySQL (optional fallback)
DB_DSN_MODE=tcp

# Used when DB_DSN_MODE=socket (Cloud Run, later). Override only if needed.
# DB_SOCKET=/cloudsql/bestmodal-492819:europe-west1:bestmodal2-sandbox-mysql

# Used when DB_DSN_MODE=tcp — Auth Proxy listens on 127.0.0.1:3306
DB_HOST=127.0.0.1
DB_PORT=3306

# Non-secret sandbox DB identity (password stays out of git).
DB_NAME=bestmodal2
DB_USER=bestmodal
# Password: never commit. Prefer Secret Manager (see README) or GitHub Environment sandbox secret.
# Local: ./scripts/sync-sandbox-db-env-from-sm.sh  (writes gitignored .env; does not echo password)
# SM secret: projects/bestmodal-492819/secrets/bestmodal2-sandbox-database-url (mysql URL)
DB_PASSWORD=

# --- GitHub Actions Environment `sandbox` (names in git; values via gh / UI) ---
# Variables:
#   INSTANCE_CONNECTION_NAME  = bestmodal-492819:europe-west1:bestmodal2-sandbox-mysql
#   DB_NAME                   = bestmodal2
#   DB_USER                   = bestmodal
# Secrets:
#   DB_PASSWORD               = from SM URL (gh secret set; never in YAML)
#   GCP_SA_KEY                = deployer SA JSON (may remain repo-level)
# Environment `production` is out of scope this slice.
# Cloud Run --add-cloudsql-instances / AUTH_MODE=db / password mounts: DEFERRED.
# Connectivity proof: php scripts/check-db-connection.php (Auth Proxy on 127.0.0.1:3306).

# Existing user table lookup for AUTH_MODE=db (DEFERRED — do not invent schema)
# DB_USERS_TABLE=users
# DB_USERS_EMAIL_COLUMN=email
# DB_USERS_PASSWORD_HASH_COLUMN=password
