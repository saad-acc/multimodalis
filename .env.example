# Multimodalis local / Cloud Run env template — no real secrets.
# Copy to `.env` for local overrides (gitignored). Compose also sets defaults.

# local | sandbox | prod
APP_ENV=local

# stub = offline login without DB (local default)
# db   = password_verify against existing Cloud SQL user rows (Cloud Run default)
AUTH_MODE=stub

# Optional stub gate. If both empty, any non-empty email+password succeeds.
# STUB_EMAIL=you@example.com
# STUB_PASSWORD=change-me

# Cloud SQL instance connection name (PLACEHOLDER — do not invent a real instance id)
# Form: PROJECT:REGION:INSTANCE
INSTANCE_CONNECTION_NAME=PROJECT:REGION:INSTANCE

# socket = Cloud Run Unix socket under /cloudsql/...
# tcp    = local Auth Proxy or Compose MySQL
DB_DSN_MODE=tcp

# Used when DB_DSN_MODE=socket (Cloud Run). Override only if needed.
# DB_SOCKET=/cloudsql/PROJECT:REGION:INSTANCE

# Used when DB_DSN_MODE=tcp (local proxy → 127.0.0.1:3306, or Compose MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306

DB_NAME=bestmodal
DB_USER=app
# Set via Secret Manager / local .env — never commit a real password
DB_PASSWORD=

# Existing user table lookup for AUTH_MODE=db (do not invent schema — set when ops confirms)
# DB_USERS_TABLE=users
# DB_USERS_EMAIL_COLUMN=email
# DB_USERS_PASSWORD_HASH_COLUMN=password
